#!/bin/bash
# Regenerates the zsh completions when this machine's recipe list changes:
# chezmoi re-runs this whenever the rendered content changes, and the list at the
# bottom is rendered in for exactly that. The other cause of a stale set — a tool
# binary changing — is mise's postinstall hook's (~/.config/mise/config.toml).
#
# The generated set is a cache that fpath falls back past, so nothing here may fail
# the apply: without mise (the install script skipped, non-Fedora Linux, a Mac with
# no Homebrew) or before `mise install` has run, defer to the hook that owns the first
# generation; a recipe that fails leaves its one file missing and says so.
set -euo pipefail

if ! command -v mise >/dev/null 2>&1; then
    echo "refresh-completions: mise is not installed, deferring to mise install's postinstall hook" >&2
    exit 0
fi
if [ -n "$(mise ls --missing 2>/dev/null)" ]; then
    echo "refresh-completions: mise toolset incomplete, deferring to mise install's postinstall hook" >&2
    exit 0
fi
# The task writes under $XDG_CACHE_HOME, which ~/.zshenv exports; an apply from another
# shell (bash, cron, ssh) has to be told the same value.
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/{{ .xdg.cacheHome }}}"
mise run refresh-completions ||
    echo "refresh-completions: some recipes failed (above); the rest were written — fix and rerun: mise run refresh-completions" >&2

# This machine's recipes, one `<command> <recipe>` per line. Never executed; here
# so the rendered content — and with it chezmoi's re-run — changes when they do.
: <<'RECIPES'
{{ includeTemplate "artifact" (merge (dict "name" "completions") .) -}}
RECIPES
