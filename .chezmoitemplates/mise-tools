{{- includeTemplate "packages-validate" . -}}
[tools]
{{- range $name, $item := .packages }}
{{- $r := includeTemplate "install-of" (dict "item" $item "key" $name "os" $.chezmoi.os "arch" $.chezmoi.arch) | fromJson }}
{{- if eq $r.backend "mise" }}
{{- $version := get $r.item "version" | default "latest" }}
{{- if hasKey $r.item "components" }}
{{- /* array spelled the way mise (toml_edit) writes it back, so its rewrites don't drift from the render */}}
"{{ $r.name }}" = { version = "{{ $version }}", components = [{{ range $i, $c := $r.item.components }}{{ if $i }}, {{ end }}{{ $c | quote }}{{ end }}] }
{{- else }}
"{{ $r.name }}" = "{{ $version }}"
{{- end }}
{{- end }}
{{- end }}
