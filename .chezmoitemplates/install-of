{{- /* How one package installs on this machine. Outputs JSON
       {"backend": "system"|"mise"|"uv"|"", "name": <name on that backend>, "item": <effective fields>}
       — backend "" means it does not install here. Args: item, key, os, arch.
       Fields are scalars; each entry of item.overrides whose $when tag equals
       os or os/arch is merged over the item, in list order. */ -}}
{{- $osarch := printf "%s/%s" .os .arch -}}
{{- $eff := omit .item "overrides" -}}
{{- range (get .item "overrides" | default list) -}}
  {{- if has (get . "$when") (list $osarch $.os) }}{{ $eff = mergeOverwrite $eff (omit . "$when") }}{{ end -}}
{{- end -}}
{{- $backend := "" }}{{ $name := "" -}}
{{- if or (has $osarch (get $eff "on")) (has .os (get $eff "on")) -}}
  {{- $backend = get $eff "via" | default "system" -}}
  {{- /* the field that renames the package on this backend: system's is the package manager's */ -}}
  {{- $field := ternary (ternary "brew" "dnf" (eq .os "darwin")) $backend (eq $backend "system") -}}
  {{- $name = get $eff $field | default .key -}}
{{- end -}}
{{- dict "backend" $backend "name" $name "item" $eff | toJson -}}
