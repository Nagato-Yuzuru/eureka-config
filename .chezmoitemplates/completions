{{- /* One `<command> <recipe>` line per zsh completion generated on this machine:
       the recipe is a sh command whose stdout is <command>'s completion. Only
       packages that install here contribute; commands and packages come out
       sorted (Go ranges maps by key). */ -}}
{{- includeTemplate "packages-validate" . -}}
{{- range $name, $item := .packages -}}
{{- $r := includeTemplate "install-of" (dict "item" $item "key" $name "os" $.chezmoi.os "arch" $.chezmoi.arch) | fromJson -}}
{{- if and (ne $r.backend "") (hasKey $r.item "completions") }}
{{- range $cmd, $recipe := $r.item.completions }}
{{ $cmd }} {{ $recipe }}
{{- end }}
{{- end }}
{{- end }}
