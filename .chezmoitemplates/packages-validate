{{- /* Schema check for .chezmoidata/packages.yaml. */ -}}
{{- $fields := list "via" "version" "brew" "dnf" "mise" "uv" "cask" "copr" "repofile" -}}
{{- $lists := list "components" -}}
{{- /* maps are not overridable: fpath order already arbitrates per-backend differences */ -}}
{{- $maps := list "completions" -}}
{{- $tags := list "darwin" "linux" "darwin/amd64" "darwin/arm64" "linux/amd64" "linux/arm64" -}}
{{- $backends := list "system" "mise" "uv" -}}
{{- range $name, $item := .packages -}}
  {{- if not (kindIs "map" $item) }}{{ fail (printf "packages.%s: must be a map" $name) }}{{ end -}}
  {{- range $k, $v := $item -}}
    {{- if has $k $fields -}}
      {{- if not (kindIs "string" $v) }}{{ fail (printf "packages.%s.%s: must be a string" $name $k) }}{{ end -}}
    {{- else if has $k $lists -}}
      {{- if or (not (kindIs "slice" $v)) (empty $v) }}{{ fail (printf "packages.%s.%s: must be a non-empty list" $name $k) }}{{ end -}}
      {{- range $v }}{{ if not (kindIs "string" .) }}{{ fail (printf "packages.%s.%s: entries must be strings" $name $k) }}{{ end }}{{ end -}}
    {{- else if has $k $maps -}}
      {{- if or (not (kindIs "map" $v)) (empty $v) }}{{ fail (printf "packages.%s.%s: must be a non-empty map of command -> recipe" $name $k) }}{{ end -}}
      {{- range $ck, $cv := $v }}{{ if or (not (kindIs "string" $cv)) (empty $cv) }}{{ fail (printf "packages.%s.%s.%s: recipe must be a non-empty string" $name $k $ck) }}{{ end }}{{ end -}}
    {{- else if eq $k "on" -}}
      {{- if or (not (kindIs "slice" $v)) (empty $v) }}{{ fail (printf "packages.%s: 'on' must be a non-empty list" $name) }}{{ end -}}
      {{- range $v }}{{ if not (has . $tags) }}{{ fail (printf "packages.%s.on: unknown tag %q" $name .) }}{{ end }}{{ end -}}
    {{- else if eq $k "overrides" -}}
      {{- if not (kindIs "slice" $v) }}{{ fail (printf "packages.%s: 'overrides' must be a list" $name) }}{{ end -}}
      {{- range $ov := $v -}}
        {{- if not (has (get $ov "$when") $tags) }}{{ fail (printf "packages.%s.overrides: each entry needs $when: <tag>" $name) }}{{ end -}}
        {{- range $ok, $ovv := (omit $ov "$when") -}}
          {{- if has $ok $lists -}}
            {{- if or (not (kindIs "slice" $ovv)) (empty $ovv) }}{{ fail (printf "packages.%s.overrides[%s].%s: must be a non-empty list" $name (get $ov "$when") $ok) }}{{ end -}}
            {{- range $ovv }}{{ if not (kindIs "string" .) }}{{ fail (printf "packages.%s.overrides[%s].%s: entries must be strings" $name (get $ov "$when") $ok) }}{{ end }}{{ end -}}
          {{- else -}}
            {{- if not (has $ok $fields) }}{{ fail (printf "packages.%s.overrides[%s]: cannot override %q" $name (get $ov "$when") $ok) }}{{ end -}}
            {{- if not (kindIs "string" $ovv) }}{{ fail (printf "packages.%s.overrides[%s].%s: must be a string" $name (get $ov "$when") $ok) }}{{ end -}}
            {{- if and (eq $ok "via") (not (has $ovv $backends)) }}{{ fail (printf "packages.%s.overrides[%s]: via must be system|mise|uv" $name (get $ov "$when")) }}{{ end -}}
          {{- end -}}
        {{- end -}}
      {{- end -}}
    {{- else }}{{ fail (printf "packages.%s: unknown key %q" $name $k) }}{{ end -}}
  {{- end -}}
  {{- if not (hasKey $item "on") }}{{ fail (printf "packages.%s: missing 'on'" $name) }}{{ end -}}
  {{- if not (has (get $item "via" | default "system") $backends) }}{{ fail (printf "packages.%s: via must be system|mise|uv" $name) }}{{ end -}}
{{- end -}}
