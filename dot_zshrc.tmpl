{{- $brewPrefix := "" }}
{{- if eq .chezmoi.os "darwin" }}{{ $brewPrefix = ternary "/opt/homebrew" "/usr/local" (eq .chezmoi.arch "arm64") }}{{ end -}}
export LANG=en_US.UTF-8

{{- if eq .chezmoi.os "darwin" }}

# What `brew shellenv` prints for this prefix, written out: forking brew cost more than every
# other eval here combined. Its `export FPATH` is left out on purpose — fpath is built below,
# and an exported FPATH leaks this shell's entries into every nested one.
export HOMEBREW_PREFIX="{{ $brewPrefix }}"
export HOMEBREW_CELLAR="{{ $brewPrefix }}/Cellar"
export HOMEBREW_REPOSITORY="{{ ternary "/opt/homebrew" "/usr/local/Homebrew" (eq .chezmoi.arch "arm64") }}"
export INFOPATH="{{ $brewPrefix }}/share/info:${INFOPATH:-}"
path=("{{ $brewPrefix }}/bin" "{{ $brewPrefix }}/sbin" $path)
{{- end }}

# .zshenv puts ~/.local/bin first, but the Homebrew prefix above takes the lead back. mise and
# uv install there from upstream, so re-assert it — otherwise `mise activate` below runs
# whatever copy a package manager left behind. (`typeset -U path` in .zshenv drops the later copy.)
path=("$HOME/.local/bin" $path)

# MISE

eval "$(mise activate zsh)"
{{- if eq .chezmoi.os "darwin" }}
eval "$(fnox activate zsh)"  # darwin-only in packages.toml
{{- end }}

{{- if eq .chezmoi.os "darwin" }}

path=("{{ $brewPrefix }}"/opt/{gawk,grep,make}/libexec/gnubin $path)
path+=("${HOME}/Library/Application Support/JetBrains/Toolbox/scripts")
{{- end }}

export EDITOR=nvim

ANTIDOTE_HOME="${XDG_CACHE_HOME}/antidote"

zsh_plugins_txt=${ZDOTDIR:-$HOME}/.zsh_plugins.txt
zsh_plugins_zsh=${ZDOTDIR:-$HOME}/.zsh_plugins.zsh

source "${XDG_DATA_HOME}/zsh/antidote/antidote.zsh"  # cloned by .chezmoiexternal.toml.tmpl


antidote_clones=($ANTIDOTE_HOME/*(N/))
if [[ ! -s $zsh_plugins_zsh || ! $zsh_plugins_zsh -nt $zsh_plugins_txt || $#antidote_clones -eq 0 ]]; then
    antidote bundle <$zsh_plugins_txt >|$zsh_plugins_zsh
fi
unset antidote_clones

# fpath, front to back — the first _<cmd> found wins:
#   hand-dropped completions; zsh-users/zsh-completions (`kind:clone` in
#   .zsh_plugins.txt: antidote only clones it, so it goes on fpath here, before
#   compinit); what Homebrew ships; what zsh and the system ship; and LAST the
#   set `mise run refresh-completions` generates from packages.toml for tools no
#   package manager covers — last on purpose, so a shipped completion always
#   beats a generated one and the generated set only ever fills gaps.
fpath=(
    "${XDG_DATA_HOME}/zsh/site-functions"
    "$(antidote path zsh-users/zsh-completions)/src"
{{- if eq .chezmoi.os "darwin" }}
    "{{ $brewPrefix }}/share/zsh/site-functions"
{{- end }}
    "${fpath[@]}"
    "${XDG_CACHE_HOME}/{{ .zsh.generatedCompletions }}"
)

autoload -Uz compinit

# Full compinit (security audit + dump rebuild) once a day, the cached dump otherwise. An array
# assignment, not `[[ -n …(#q…) ]]`: that form needs extendedglob, and without it the test
# is a non-empty literal string, always true.
zcompdump_stale=(${ZDOTDIR:-$HOME}/.zcompdump(Nmh+24))
if [[ ! -s ${ZDOTDIR:-$HOME}/.zcompdump ]] || (( $#zcompdump_stale )); then
    compinit
else
    compinit -C
fi
unset zcompdump_stale

{ zcompile ${ZDOTDIR:-$HOME}/.zcompdump; } &|

autoload bashcompinit && bashcompinit

source $zsh_plugins_zsh

# terraform/tofu only ship bash-protocol completion (`complete -C <binary>`);
# bashcompinit (above) runs it under zsh.
command -v terraform &>/dev/null && complete -o nospace -C "$(command -v terraform)" terraform
command -v tofu &>/dev/null && complete -o nospace -C "$(command -v tofu)" tofu

zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*' menu select
zstyle ':completion:*:descriptions' format '%d'

if command -v ast-grep &>/dev/null && command -v sg &>/dev/null &&
    whence -w _ast-grep &>/dev/null; then
    compdef _ast-grep sg
fi

# Starship
eval "$(starship init zsh)"


{{- if eq .chezmoi.os "darwin" }}

# 1password

export SSH_AUTH_SOCK="${HOME}/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
[ -f "${XDG_CONFIG_HOME}/op/plugins.sh" ] && source "${XDG_CONFIG_HOME}/op/plugins.sh"
{{- end }}

# fzf
if command -v fzf &>/dev/null; then
    source <(fzf --zsh)
fi

{{- $dircolors := "dircolors" }}
{{- if eq .chezmoi.os "darwin" }}{{ $dircolors = "gdircolors" }}{{ end }}
if command -v {{ $dircolors }} &>/dev/null; then
    eval "$({{ $dircolors }} -b)"
    zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
else
    export CLICOLOR=1
fi

zstyle ':completion:*:git-checkout:*' sort false
zstyle ':fzf-tab:complete:*' fzf-preview \
    'local p=${word%% }
   if [[ -d $p ]]; then tree -C -L 2 $p
   elif [[ -f $p ]]; then bat --color=always --line-range=:300 --style=numbers $p
   fi'
zstyle ':fzf-tab:complete:*' fzf-flags --preview-window=right:60%:wrap
zstyle ':fzf-tab:*' fzf-bindings \
    'ctrl-e:accept' \
    'ctrl-f:preview-half-page-down' \
    'ctrl-b:preview-half-page-up' \
    'ctrl-/:toggle-preview'
zstyle ':fzf-tab:*' continuous-trigger '/'
zstyle ':fzf-tab:*' query-string prefix first
# -------------------
# zsh options

bindkey -e

setopt auto_cd
setopt autopushd
setopt hist_ignore_all_dups
setopt hist_ignore_space

typeset -i DIRSTACKSIZE=127

export WORDCHARS=${WORDCHARS/\//}
{{- if eq .chezmoi.os "darwin" }}
export HOMEBREW_AUTO_UPDATE_SECS=3600
{{- end }}

# shell hotkey settings

autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^U' backward-kill-line
bindkey '^X^E' edit-command-line

autoload -Uz reverse-menu-complete
zle -N reverse-menu-complete
zmodload zsh/complist
bindkey -M menuselect '^[[Z' reverse-menu-complete

bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
bindkey '^P' history-substring-search-up
bindkey '^N' history-substring-search-down

# aliases
alias rm='rm -i'
alias mv='mv -i'
alias vim='nvim'
alias watch='watch --color'

alias pip='uv pip'
alias pip3='uv pip'
alias python='python3'

alias fd='fd --color=auto'
alias tf='terraform'


{{- if eq .chezmoi.os "darwin" }}
alias typora='open -a Typora'
alias sed='gsed'
alias date='gdate'
{{- end }}
{{- if eq .chezmoi.os "darwin" }}
alias ls='ls -G --color=auto'
{{- else }}
alias ls='ls --color=auto'
{{- end }}
alias grep='grep --color=auto'

function grt() {
    local root
    root=$(git rev-parse --show-toplevel 2>/dev/null) || {
        echo "not in a git repo" >&2
        return 1
    }
    cd "$root/$1"
}

function yazi() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
    command yazi "$@" --cwd-file="$tmp"
    if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
        builtin cd -- "$cwd"
    fi
    rm -f -- "$tmp"
}

{{- if eq .chezmoi.os "darwin" }}
alias cleanproxy='networksetup -setwebproxystate Wi-Fi off && networksetup -setsecurewebproxystate Wi-Fi off && networksetup -setautoproxystate Wi-Fi off'
{{- end }}

function welcome() {
    if ! command -v cowsay &>/dev/null; then return; fi

    local cows=(alpaca bud-frogs cheese cupcake elephant eyes fox llama milk moose stegosaurus sus turtle tux)
    local moods=(-b -d -g -p -s -t -w)

    figlet -c "Welcome $1" |
        cowsay -n "${moods[RANDOM % $#moods + 1]}" -f "${cows[RANDOM % $#cows + 1]}" |
        lolcat
}

if [[ -o interactive && -o login && -z $TMUX && -z $INTELLIJ_ENVIRONMENT_READER ]]; then
    welcome "YuzuRu"
fi
