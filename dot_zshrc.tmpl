export LANG=en_US.UTF-8

{{- if eq .chezmoi.os "darwin" }}
if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi
{{- end }}

# MISE

eval "$(mise activate zsh)"

{{- if eq .chezmoi.os "darwin" }}

local brew_prefix="$(brew --prefix)"
local gnu_path=""

for gnu in make grep gawk; do
    gnu_path="${brew_prefix}/opt/${gnu}/libexec/gnubin:$gnu_path"
done

export PATH="$gnu_path$PATH"

export PATH="$PATH:${HOME}/Library/Application Support/JetBrains/Toolbox/scripts"
{{- end }}

export EDITOR=nvim
# ------------
#
{{- if eq .chezmoi.os "darwin" }}
ANTIDOTE_HOME="$(brew --prefix)/share/antidote"
{{- else if eq .chezmoi.os "linux" }}
# Antidote installation path for Linux
# Install antidote: git clone --depth=1 https://github.com/mattmc3/antidote.git ${ZDOTDIR:-~}/.antidote
ANTIDOTE_HOME="${ZDOTDIR:-${HOME}}/.antidote/"
{{- end }}

zsh_plugins_txt=${ZDOTDIR:-$HOME}/.zsh_plugins.txt
zsh_plugins_zsh=${ZDOTDIR:-$HOME}/.zsh_plugins.zsh

source $ANTIDOTE_HOME/antidote.zsh

if [[ ! -s $zsh_plugins_zsh || ! $zsh_plugins_zsh -nt $zsh_plugins_txt ]]; then
    antidote bundle <$zsh_plugins_txt >|$zsh_plugins_zsh
fi

fpath=(
    "${HOME}/.zsh/completions"
    "${XDG_DATA_HOME}/zsh/site-functions"
    $(antidote path)
{{- if eq .chezmoi.os "darwin" }}
    "$(brew --prefix)/share/zsh/site-functions"
{{- end }}
    "${fpath[@]}"
)

fpath=(${(u)fpath})

autoload -Uz compinit

if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qNmh+24) ]]; then
    compinit
else
    compinit -C
fi

{ zcompile ${ZDOTDIR:-$HOME}/.zcompdump; } &|

autoload bashcompinit && bashcompinit

source $zsh_plugins_zsh

if command -v carapace &>/dev/null; then
    # NOTE: do NOT add 'zsh' here. carapace is already the zsh completer for
    # every command, so bridging zsh->zsh is circular: carapace's ~1578
    # "bridge to zsh" commands (uv, etc.) resolve back to _carapace_completer,
    # which the bridge subshell can't invoke -> "command not found:
    # _carapace_completer". Omitting zsh lets those commands keep their own
    # native completions (e.g. _uv).
    export CARAPACE_BRIDGES='bash,inshellisense'
    zstyle ':completion:*' format-explanation '  %e'
    source <(carapace _carapace)
fi

# antidote load

zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*' menu select
zstyle ':completion:*:descriptions' format '%d'

if command -v prek &>/dev/null; then
    eval "$(COMPLETE=zsh prek)"
fi

if command -v ast-grep &>/dev/null && command -v sg &>/dev/null \
    && whence -w _ast-grep &>/dev/null; then
    compdef _ast-grep sg
fi

# Starship
eval "$(starship init zsh)"


{{- if eq .chezmoi.os "darwin" }}

# 1password

export SSH_AUTH_SOCK="${HOME}/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
[ -f "$HOME/.config/op/plugins.sh" ] && source "${HOME}/.config/op/plugins.sh"
{{- end }}

# fzf
if command -v fzf &>/dev/null; then
    source <(fzf --zsh)
fi

{{- if eq .chezmoi.os "darwin" }}
if command -v gdircolors &>/dev/null; then
    eval "$(gdircolors -b)"
    zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
else
    export CLICOLOR=1
fi
{{- else if eq .chezmoi.os "linux" }}
if command -v dircolors &> /dev/null; then
    eval "$(dircolors -b)"
    zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
else
    export CLICOLOR=1
fi
{{- end }}

zstyle ':completion:*:git-checkout:*' sort false
zstyle ':fzf-tab:complete:*' fzf-preview \
    'local p=${word%% }
   if [[ -d $p ]]; then tree -C -L 2 $p
   elif [[ -f $p ]]; then bat --color=always --line-range=:300 --style=numbers $p
   fi'
zstyle ':fzf-tab:complete:*' fzf-flags --preview-window=right:60%:wrap
zstyle ':fzf-tab:*' fzf-bindings \
    'ctrl-e:accept' \
    'ctrl-f:preview-half-page-down' \
    'ctrl-b:preview-half-page-up' \
    'ctrl-/:toggle-preview'
zstyle ':fzf-tab:*' continuous-trigger '/'
zstyle ':fzf-tab:*' query-string prefix first
# -------------------
# zsh options

bindkey -e

setopt auto_cd
setopt autopushd
typeset -i DIRSTACKSIZE=127

export WORDCHARS=${WORDCHARS/\//}
{{- if eq .chezmoi.os "darwin" }}
export HOMEBREW_AUTO_UPDATE_SECS=3600
{{- end }}

# shell hotkey settings

autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^U' backward-kill-line
bindkey '^X^E' edit-command-line

autoload -Uz reverse-menu-complete
zle -N reverse-menu-complete
zmodload zsh/complist
bindkey -M menuselect '^[[Z' reverse-menu-complete

bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
bindkey '^P' history-substring-search-up
bindkey '^N' history-substring-search-down

# aliases
alias rm='rm -i'
alias mv='mv -i'
alias vim='nvim'
alias watch='watch --color'

alias pip='uv pip'
alias pip3='uv pip'
alias python='python3'

alias fd='fd --color=auto'
alias tf='terraform'


{{- if eq .chezmoi.os "darwin" }}
alias typora='open -a Typora'
alias sed='gsed'
alias date='gdate'
{{- end }}
{{- if eq .chezmoi.os "darwin" }}
alias ls='ls -G --color=auto'
{{- else }}
alias ls='ls --color=auto'
{{- end }}
alias grep='grep --color=auto'

function grt() {
    local root
    root=$(git rev-parse --show-toplevel 2>/dev/null) || {
        echo "not in a git repo" >&2
        return 1
    }
    cd "$root/$1"
}

function yazi() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
    command yazi "$@" --cwd-file="$tmp"
    if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
        builtin cd -- "$cwd"
    fi
    rm -f -- "$tmp"
}

{{- if eq .chezmoi.os "darwin" }}
alias cleanproxy='networksetup -setwebproxystate Wi-Fi off && networksetup -setsecurewebproxystate Wi-Fi off && networksetup -setautoproxystate Wi-Fi off'
{{- end }}

function wellcome() {
    if ! command -v cowsay &>/dev/null; then return; fi

    local cows=(alpaca bud-frogs cheese cupcake daemon elephant eyes fox head-in llama milk moose mutilated stegosaurus sus turtle tux)
    local cow=$(shuf -n 1 -e "${cows[@]}")
    local mood=$(shuf -n 1 -e -- -b -d -g -p -s -t -w)

    figlet -c "Welcome $1" |
        cowsay -n "$mood" -f "$cow" |
        lolcat
}

[[ -o interactive && -z "${INTELLIJ_ENVIRONMENT_READER}" ]] && wellcome "YuzuRu"
