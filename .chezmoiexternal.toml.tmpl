# Git repos cloned into place — upstream tools under $XDG_DATA_HOME (see .chezmoidata/xdg.toml),
# plus my own nvim config under ~/.config.
# Tracks upstream default branch; pulled at most once per refreshPeriod
# (force with `chezmoi apply --refresh-externals`).

# oh-my-tmux — symlinked into place by dot_config/tmux/symlink_tmux.conf.tmpl
["{{ .xdg.dataHome }}/oh-my-tmux"]
    type = "git-repo"
    url = "git@github.com:gpakosz/.tmux.git"
    refreshPeriod = "168h"

# antidote — sourced by .zshrc, on every machine: a plain zsh script, so a package manager
# adds nothing a clone lacks (brew's formula is the same files plus man pages, which the
# repo carries too). Not $XDG_DATA_HOME/antidote: antidote itself writes snapshots/ there
# (observed on the lab VM), even though ANTIDOTE_HOME points at the cache dir.
["{{ .xdg.dataHome }}/zsh/antidote"]
    type = "git-repo"
    url = "git@github.com:mattmc3/antidote.git"
    refreshPeriod = "168h"

# Neovim config — my own repo, edited and pushed from inside the clone, so the refresh
# pull is --ff-only: local commits or a dirty tree fail the pull loudly instead of
# chezmoi growing merge commits in it. Literal .config: see .chezmoidata/xdg.toml.
[".config/nvim"]
    type = "git-repo"
    url = "git@github.com:Nagato-Yuzuru/my-nvim-config.git"
    refreshPeriod = "168h"
    [".config/nvim".pull]
        args = ["--ff-only"]
