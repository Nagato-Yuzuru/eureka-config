# Global fnox config: credential-mediation base for the night-shift system.
# Day-side tools stay on 1Password op plugins by design (presence-gated).
# The night profile holds credentials only; the hygiene env lives in
# ~/.claude/night/env.sh.

# Custody is per-OS. darwin: the login keychain, ACL bound to the fnox
# binary. linux has no unlocked secret service, so night custody rides an
# age key the owner places at ~/.config/fnox/age.key when provisioning the
# machine (setup wizard, linux custody stage); recipient and ciphertext
# are committed in .chezmoidata/night.toml — both are public-safe.
{{ if eq .chezmoi.os "darwin" -}}
[providers.keychain]
type = "keychain"
service = "fnox"
{{ else -}}
[providers.age]
type = "age"
recipients = [{{ .night.age.recipient | quote }}]
key_file = "~/.config/fnox/age.key"
{{ end -}}

# Day-custody vault for the agent system; membership across vaults is
# tracked by the agent-system TAG, this vault is just the default home.
# The night SA cannot read it (SA is scoped to the "Night" vault;
# preflight asserts exactly that), so anything here is mechanically
# day-only: at night the op sentinel kills the path in ~50ms and the
# desktop app is locked anyway. Day resolution rides the desktop app, so
# every mint is presence-gated.
[providers.onepass]
type = "1password"
vault = "Night Shift Agents"

# Day-side cache for activate's per-prompt hook-env resolution (memory
# only, unix socket, same-uid). The short idle timeout keeps the in-memory
# half-life small; /night on additionally runs `fnox daemon clear` so no
# day secret value survives across the boundary. The night shim never
# touches it (--no-daemon).
[daemon]
idle_timeout = "2h"

# fnox profile semantics: the top-level [secrets] table merges into EVERY
# named profile; named profiles are isolated from each other. The base
# therefore stays EMPTY. A base secret would silently join the night
# surface and break "the night list is the complete night credential set"
# (tests pin this).
#
# Day profile: minting credentials, resolved with -P day. LINEAR_BOT_CLIENT_SECRET
# mints the "Night Shift Agent" Linear app token (client_credentials grant,
# 30-day tokens) so agent-authored issues and comments are attributed to
# the app user, not the owner. Night sessions use an already-minted token,
# never the secret; the onepass provider makes that mechanical (see above).
[profiles.day.secrets]
LINEAR_BOT_CLIENT_SECRET = { provider = "onepass", value = "op://Night Shift Agents/Linear Night Shift Agent/client_secret" }

# Night profile: CREDENTIALS ONLY. This list is the complete set of night
# credentials; an undeclared credential does not exist at night.
# keyring_cache=false is load-bearing: fnox then discards the 184-day
# refresh token GitHub mints alongside every 8h access token, so nothing on
# disk can renew authority without a fresh device-flow approval.
# "Authorize while awake" rests here.
[profiles.night.secrets]
{{ if eq .chezmoi.os "darwin" -}}
OP_SERVICE_ACCOUNT_TOKEN = { provider = "keychain", value = "OP_SERVICE_ACCOUNT_TOKEN" }
{{ else if .night.age.sa_token_ciphertext -}}
OP_SERVICE_ACCOUNT_TOKEN = { provider = "age", value = {{ .night.age.sa_token_ciphertext | quote }} }
{{ else -}}
# UNPROVISIONED: no night custody on this machine yet. Run the setup
# wizard's linux custody stage; preflight fails the SA check until then.
{{ end -}}

[profiles.night.leases.github]
type = "github-oauth"
client_id = "Iv23lifV6li4jkqWVVej"
env_var = "GH_TOKEN"
keyring_cache = false
# NOTE(YUZ-77): `night gh` would ride `fnox proxy run` (the real token
# never enters an agent-visible process), but 1.34.0's proxy rules cannot
# reference leases. Until the upstream fix lands, gh rides exec and the
# shim carries the gh argv checks.
