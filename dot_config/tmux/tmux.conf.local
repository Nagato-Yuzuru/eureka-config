
# : << 'EOF'
# https://github.com/gpakosz/.tmux
# (‑●‑●)> dual licensed under the WTFPL v2 license and the MIT license,
#         without any warranty.
#         Copyright 2012— Gregory Pakosz (@gpakosz).

tmux_conf_preserve_stock_bindings=false

# 新建会话/窗口设置
tmux_conf_new_session_prompt=false
tmux_conf_new_session_retain_current_path=false
tmux_conf_new_window_retain_current_path=false
tmux_conf_new_window_reconnect_ssh=false
tmux_conf_new_pane_retain_current_path=true
tmux_conf_new_pane_reconnect_ssh=false

# 剪贴板与 URL 设置
tmux_conf_copy_to_os_clipboard=true
tmux_conf_urlscan_options="--compact --dedupe"

set -g mouse on
# 缩短 Esc 抖动延迟，让 nvim 退 insert 模式即时响应（默认 500ms 太长）
set -g escape-time 10
# set -gu prefix2
unbind C-a
unbind C-b
unbind -n C-,
bind -n C-, send-keys C-,

set -gu prefix2
set -g prefix M-\'
bind M-\' send-prefix

unbind -n C-h
unbind -n C-j
unbind -n C-k
unbind -n C-l

bind-key / copy-mode \; send-keys "?"

# See: https://github.com/christoomey/vim-tmux-navigator
vim_pattern='(\S+/)?g?\.?(view|l?n?vim?x?|fzf)(diff)?(-wrapped)?'
is_vim="ps -o state= -o comm= -t '#{pane_tty}' \
    | grep -iqE '^[^TXZ ]+ +${vim_pattern}$'"

bind-key 'C-h' if-shell "$is_vim" 'send-keys C-h'  'select-pane -L'
bind-key 'C-j' if-shell "$is_vim" 'send-keys C-j'  'select-pane -D'
bind-key 'C-k' if-shell "$is_vim" 'send-keys C-k'  'select-pane -U'
bind-key 'C-l' if-shell "$is_vim" 'send-keys C-l'  'select-pane -R'
tmux_version='$(tmux -V | sed -En "s/^tmux ([0-9]+(.[0-9]+)?).*/\1/p")'
if-shell -b '[ "$(echo "$tmux_version < 3.0" | bc)" = 1 ]' \
    "bind-key -n 'C-\\' if-shell \"$is_vim\" 'send-keys C-\\'  'select-pane -l'"
if-shell -b '[ "$(echo "$tmux_version >= 3.0" | bc)" = 1 ]' \
    "bind-key -n 'C-\\' if-shell \"$is_vim\" 'send-keys C-\\\\'  'select-pane -l'"

bind-key -T copy-mode-vi 'C-h' select-pane -L
bind-key -T copy-mode-vi 'C-j' select-pane -D
bind-key -T copy-mode-vi 'C-k' select-pane -U
bind-key -T copy-mode-vi 'C-l' select-pane -R
bind-key -T copy-mode-vi 'C-\' select-pane -l

# select windows
unbind -n C-p
unbind -n C-n


bind C-n next-window
bind C-p previous-window

# next-layout：prefix+Space 已被 which-key 占用，挪到 Alt+Space
bind -r M-Space next-layout

# sync panes：把当前 window 内所有 pane 的键盘输入广播在一起。常用于多机 SSH 同步操作。
# prefix + S 切换；状态栏会闪一下提示新状态，平时由 #{synchronized} 持续指示。
bind S setw synchronize-panes \; display-message "Sync panes: #{?pane_synchronized,ON,off}"


# set -g prefix C-a
# bind C-a send-prefix

# if you don't want Oh my tmux! to alter a binding or a setting, use #!important
# bind c new-window -c '#{pane_current_path}' #!important

bind C-c new-session -c "$HOME" 

# pane mark / unmark：恢复 tmux 默认含义（原来 `m` 被改成 mouse toggle，已去掉；
# 临时开关 mouse 用 `prefix :` set mouse on/off 兜底）。
# mark 后，`prefix @` 把它拉到当前 pane 旁边；swap-pane / move-pane 也默认用 marked pane。
bind m select-pane -m \; display "pane marked"
bind M select-pane -M \; display "mark cleared"

# join-pane：与 tmux 默认 `prefix !` break-pane 对称。
# 默认 -h，marked pane 出现在当前 pane 右侧（左右分屏）。
bind @ join-pane -h

# prefix ? 改成 tmux-fzf 的 keybinding 模糊搜索（替换默认 list-keys 纯文本 dump）。
# 内容仍来自 `tmux list-keys`（全量），多了 fzf 过滤；选中回车直接执行。
# 想看原始 dump：`prefix :` list-keys。
bind ? run-shell -b "#{TMUX_PLUGIN_MANAGER_PATH}/tmux-fzf/scripts/keybinding.sh"


# display
tmux_conf_24b_colour=auto
set -g default-terminal "tmux-256color"
set -as terminal-overrides ',*:Tc'
set -g focus-events on

# Forward kitty-keyboard-protocol / CSI-u extended keys to inner programs.
# Required by ~/.config/nvim/lua/core/keymaps.lua — <C-S-A> (decrement) must be
# distinguishable from <C-a> (increment). Outer terminal must also support it
# (WezTerm: enable_kitty_keyboard = true). After changing, run `tmux kill-server`.
set -s  extended-keys on
# Report modified keys to inner apps in CSI-u form, NOT xterm modifyOtherKeys.
# tmux's default is `xterm` (^[[27;5;48~), which Neovim cannot decode into <C-0>
# — Ctrl+<digit> collapses to a bare `0`. nvim speaks the kitty/CSI-u form
# (^[[48;5u), so csi-u is required for <C-x><C-0> etc. Takes effect live (no
# kill-server needed; unlike terminal-features it is read at keypress time).
set -s  extended-keys-format csi-u
set -as terminal-features '*:extkeys'

# Forward SGR 4:3 (undercurl) + 4:58 (colored underline) to outer terminal.
# WezTerm supports both natively. Without this, tmux-256color's terminfo lacks
# Smulx and nvim falls back to plain underline for DiagnosticUnderline*。
# 改完需要 `tmux kill-server` 才生效（live source 不重算 terminal-features）。
set -as terminal-features '*:usstyle'

# OSC 52：让 tmux 把 set-buffer -w 的内容转发给宿主终端剪贴板（WezTerm 原生支持）。
# 默认值 external 已够用；显式置 on 同时允许内层程序（如 nvim）通过 OSC 52 写剪贴板。
set -s set-clipboard on

tmux_conf_theme=enabled

set -g allow-passthrough on
set -ga update-environment TERM
set -ga update-environment TERM_PROGRAM

# 2. 定义调色板 (Tokyo Night Palette)
tmux_conf_theme_colour_1="#1a1b26"    # Black (Night BG)
tmux_conf_theme_colour_2="#24283b"    # Dark Grey (Storm BG) - 状态栏底色
tmux_conf_theme_colour_3="#414868"    # Grey (Selection)
tmux_conf_theme_colour_4="#7aa2f7"    # Blue (Focus) - 强调色
tmux_conf_theme_colour_5="#e0af68"    # Yellow (Warning)
tmux_conf_theme_colour_6="#1a1b26"    # Black
tmux_conf_theme_colour_7="#c0caf5"    # White
tmux_conf_theme_colour_8="#1a1b26"    # Black
tmux_conf_theme_colour_9="#bb9af7"    # Magenta - 用户名背景
tmux_conf_theme_colour_10="#f7768e"   # Red
tmux_conf_theme_colour_11="#9ece6a"   # Green
tmux_conf_theme_colour_12="#a9b1d6"   # Light Grey - 默认文字
tmux_conf_theme_colour_13="#c0caf5"   # White
tmux_conf_theme_colour_14="#1a1b26"   # Black
tmux_conf_theme_colour_15="#1a1b26"   # Black
tmux_conf_theme_colour_16="#f7768e"   # Red
tmux_conf_theme_colour_17="#c0caf5"   # White

# 状态栏内部分隔符色（更暗的 Tokyo Night Storm 灰，独立于 17 标准槽）
tmux_conf_theme_separator_fg="#3b4261"

# 3. 界面元素样式 (引用上方变量)

# 状态栏背景/前景
tmux_conf_theme_status_bg="$tmux_conf_theme_colour_2"
tmux_conf_theme_status_fg="$tmux_conf_theme_colour_12"
tmux_conf_theme_status_attr="none"

# 窗口标题栏
tmux_conf_theme_window_status_bg="$tmux_conf_theme_colour_2"
tmux_conf_theme_window_status_fg="$tmux_conf_theme_colour_12"
tmux_conf_theme_window_status_attr="none"

# 当前活动窗口 (Tokyo Night Blue)
tmux_conf_theme_window_status_current_bg="$tmux_conf_theme_colour_4"
tmux_conf_theme_window_status_current_fg="$tmux_conf_theme_colour_1"
tmux_conf_theme_window_status_current_attr="bold"

# 边框样式
tmux_conf_theme_pane_border_style=thin
tmux_conf_theme_pane_border="$tmux_conf_theme_colour_3"
tmux_conf_theme_pane_active_border="$tmux_conf_theme_colour_4" # 激活边框变蓝
tmux_conf_theme_pane_indicator="$tmux_conf_theme_colour_4"
tmux_conf_theme_pane_active_indicator="$tmux_conf_theme_colour_4"

# 消息/命令模式 (Cyan/Blue 风格)
tmux_conf_theme_message_bg="$tmux_conf_theme_colour_4"
tmux_conf_theme_message_fg="$tmux_conf_theme_colour_1"
tmux_conf_theme_message_attr="fill=$tmux_conf_theme_message_bg,bold"
tmux_conf_theme_mode_bg="$tmux_conf_theme_colour_4"   # 复制模式选中色(窗格内,无需 fill)
tmux_conf_theme_mode_fg="$tmux_conf_theme_colour_1"
tmux_conf_theme_mode_attr="bold"
# message-command = 提示符里按 Esc 进入 vi normal 模式(status-keys vi)时的样式:用红区分于输入态的蓝
tmux_conf_theme_message_command_bg="$tmux_conf_theme_colour_10"  # 红 #f7768e
tmux_conf_theme_message_command_fg="$tmux_conf_theme_colour_1"
tmux_conf_theme_message_command_attr="fill=$tmux_conf_theme_message_command_bg,bold"

# 4. 状态栏内容配置
tmux_conf_theme_terminal_title="#h ❐ #S ● #I #W"
tmux_conf_theme_window_status_format="#I #W#{?#{||:#{window_bell_flag},#{window_zoomed_flag}}, ,}#{?window_bell_flag,!,}#{?window_zoomed_flag,Z,}"
tmux_conf_theme_window_status_current_format="#I #W#{?#{||:#{window_bell_flag},#{window_zoomed_flag}}, ,}#{?window_bell_flag,!,}#{?window_zoomed_flag,Z,}"

# 分隔符 (Powerline)
tmux_conf_theme_left_separator_main=""
tmux_conf_theme_left_separator_sub=""

tmux_conf_theme_right_separator_main=""
tmux_conf_theme_right_separator_sub=""
# --- 左侧状态栏修改 ---
# 结构： Session名称 | CPU负载
tmux_conf_theme_status_left="   #S "
# 颜色逻辑：
tmux_conf_theme_status_left_fg="$tmux_conf_theme_colour_1"
tmux_conf_theme_status_left_bg="$tmux_conf_theme_colour_4"
tmux_conf_theme_status_left_attr="bold"

# --- 右侧状态栏 (Nerd Font 数值仪表盘) ---
# 结构： Prefix | CPU | RAM | Swap | Battery | User | Host
# 特性： 
# 1. 动态颜色：CPU/RAM/Swap 正常显示蓝色(#7aa2f7)，高负载变红(#f7768e)
# 2. 区分用户：User 使用洋红背景(Magenta)，Host 使用蓝色背景(Blue)

tmux_conf_theme_status_right="#{sysmon #{TMUX_PLUGIN_MANAGER_PATH}}#{battinfo #{TMUX_PLUGIN_MANAGER_PATH}} #{prefix}#{mouse}#{pairing}#{synchronized} \
#[fg=$tmux_conf_theme_separator_fg]| #{?#{>=:#{@cpu_n},080},#[fg=$tmux_conf_theme_colour_10],#{?#{>=:#{@cpu_n},030},#[fg=$tmux_conf_theme_colour_5],#[fg=$tmux_conf_theme_colour_4]}} #{@cpu} \
#[fg=$tmux_conf_theme_separator_fg]| #{?#{>=:#{@ram_n},080},#[fg=$tmux_conf_theme_colour_10],#{?#{>=:#{@ram_n},030},#[fg=$tmux_conf_theme_colour_5],#[fg=$tmux_conf_theme_colour_4]}} #{@ram} \
#[fg=$tmux_conf_theme_separator_fg]| #[fg=$tmux_conf_theme_colour_4]󰓡 #[fg=$tmux_conf_theme_colour_12]#{@swap} \
#[fg=$tmux_conf_theme_separator_fg]| #{@batt_fg}#[bg=$tmux_conf_theme_colour_2]#{@batt_icon} #[bg=$tmux_conf_theme_colour_2]#{@batt_pct} \
#[fg=$tmux_conf_theme_separator_fg]| #[fg=$tmux_conf_theme_colour_9,bold]#{username}#[fg=$tmux_conf_theme_colour_12,nobold] @ #[fg=$tmux_conf_theme_colour_4,bold]#{hostname} "

# 兜底样式 (深灰背景)
tmux_conf_theme_status_right_fg="$tmux_conf_theme_colour_12"
tmux_conf_theme_status_right_bg="$tmux_conf_theme_colour_2"
tmux_conf_theme_status_right_attr="none"

# 电池与时钟样式
tmux_conf_battery_bar_palette="gradient"
tmux_conf_theme_clock_colour="$tmux_conf_theme_colour_4"
tmux_conf_theme_clock_style="24"

# move status line to top
#set -g status-position top


# -- tpm -----------------------------------------------------------------------

# while I don't use tpm myself, many people requested official support so here
# is a seamless integration that automatically installs plugins in parallel

# whenever a plugin introduces a variable to be used in 'status-left' or
# 'status-right', you can use it in 'tmux_conf_theme_status_left' and
# 'tmux_conf_theme_status_right' variables.

# by default, launching tmux will update tpm and all plugins
#   - true (default)
#   - false
tmux_conf_update_plugins_on_launch=true

# by default, reloading the configuration will update tpm and all plugins
#   - true (default)
#   - false
tmux_conf_update_plugins_on_reload=true

# by default, reloading the configuration will uninstall tpm and plugins when no
# plugins are enabled
#   - true (default)
#   - false
tmux_conf_uninstall_plugins_on_reload=true

# /!\ the tpm bindings differ slightly from upstream:
#   - installing plugins: <prefix> + I
#   - uninstalling plugins: <prefix> + Alt + u
#   - updating plugins: <prefix> + u

# /!\ do not add set -g @plugin 'tmux-plugins/tpm'
# /!\ do not add run '~/.tmux/plugins/tpm/tpm'

# /!\ the 'set -g @tpm_plugins' syntax is not supported
# to enable a plugin, use the 'set -g @plugin' syntax:
# visit https://github.com/tmux-plugins for available plugins
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'

set -g @continuum-restore 'off'
set -g @continuum-save-interval '10'
set -g @resurrect-dir "$HOME/.local/state/tmux/resurrect"

set -g @plugin 'tmux-plugins/tmux-cpu'
set -g @plugin 'tmux-plugins/tmux-battery'

# 2.1 监控颜色阈值 (Tokyo Night)
# CPU/RAM 的三档配色已改为 tmux 原生格式，直接写在 tmux_conf_theme_status_right
# 里（阈值 30/80，与 tmux-cpu 默认一致），不再经过插件的 *_fg_color 脚本 —— 那
# 些脚本会把 *_percentage.sh 当子进程整个再跑一遍，是原先开销的主要来源。
# 调色请改上面的 tmux_conf_theme_colour_4/5/10，此处不再有可调项。

# 2.2 电池图标与颜色
set -g @batt_icon_charge_tier8 ' '
set -g @batt_icon_charge_tier7 ' '
set -g @batt_icon_charge_tier6 ' '
set -g @batt_icon_charge_tier5 ' '
set -g @batt_icon_charge_tier4 ' '
set -g @batt_icon_charge_tier3 ' '
set -g @batt_icon_charge_tier2 ' '
set -g @batt_icon_charge_tier1 ' '
set -g @batt_icon_status_charged ' '
set -g @batt_icon_status_charging '⚡'

# Tier 8-5 (高电量): 使用柔和的 Tokyo Night Blue (#7aa2f7)
# Tier 4-3 (中电量): 使用 Light Grey (#a9b1d6) 或 Yellow (#e0af68) 过渡
# Tier 2-1 (低电量): 保持 Red (#f7768e) 警告

set -g @batt_color_charge_primary_tier8 '#7aa2f7'
set -g @batt_color_charge_primary_tier7 '#7aa2f7'
set -g @batt_color_charge_primary_tier6 '#7aa2f7'
set -g @batt_color_charge_primary_tier5 '#7aa2f7'
set -g @batt_color_charge_primary_tier4 '#a9b1d6'
set -g @batt_color_charge_primary_tier3 '#e0af68'
set -g @batt_color_charge_primary_tier2 '#f7768e'
set -g @batt_color_charge_primary_tier1 '#f7768e'


set -g @plugin 'omerxx/tmux-sessionx'
set -g @sessionx-window-height '85%'
set -g @sessionx-window-width '75%'
set -g @sessionx-bind 'o'


set -g @sessionx-preview-location 'right'
set -g @sessionx-preview-ratio '55%'

set -g @plugin 'tmux-plugins/tmux-yank' # 辅助复制（自动探测 pbcopy/xclip/wl-copy/clip.exe）
set -g @plugin 'laktak/extrakto'
set -g @extrakto_clip_tool "auto"   # 让 extrakto 自己探测平台剪贴板
set -g @extrakto_editor "nvim"      # 按 ctrl-e 编辑时使用 nvim
set -g @extrakto_fzf_tool "fzf"

# === 升级补丁：discoverability + fzf + 抓屏 jump + 浮窗 ===

# tmux-which-key：prefix + Space 弹出按键菜单，告别"不会就不会用"
set -g @plugin 'alexwforsythe/tmux-which-key'

# tmux-fzf：prefix + f 进入 fzf 总入口（kill-pane / kill-window / kill-session / 切 session …）
set -g @plugin 'sainnhe/tmux-fzf'
set-environment -g TMUX_FZF_LAUNCH_KEY 'f'

# tmux-thumbs：prefix + j 在屏幕上对 URL / 路径 / hash / 数字 打 hint
# 小写字母 = 拷到系统剪贴板（走 tmux OSC 52，无需 pbcopy/xclip）
# 大写字母 = 拷贝并直接粘到当前 pane（终端内立即用）
set -g @plugin 'fcsonline/tmux-thumbs'
set -g @thumbs-key j
set -g @thumbs-command 'tmux set-buffer -w -- {}'
set -g @thumbs-upcase-command 'tmux set-buffer -w -- {} && tmux paste-buffer'

# tmux-jump：vim-easymotion 风格的"任意字符"跳转（thumbs 是固定正则匹配，jump 才是任意文本）
# 用法：prefix + J → 输入一个字符 → 屏幕上该字符的所有出现位置叠加字母 → 按字母光标直接跳过去
# （进 copy-mode 后用更顺手；外面用会自动切到 copy-mode）
set -g @plugin 'schasse/tmux-jump'
set -g @jump-key 'J'

# 浮窗（display-popup，tmux 3.2+）：弹输入框 → 把输入的命令在浮窗里跑
# - 例：输入 "lazygit" / "btop" / "nvim ." / "git log --oneline -20"
# - 空输入直接 Enter → 浮窗打开当前 $SHELL（默认行为）
# - 输出看完后按命令自身退出键，浮窗会关掉（display-popup -E）
bind -N "Popup prompt" ';' command-prompt -p "popup>" \
  "display-popup -E -w 80% -h 80% -d '#{pane_current_path}' '%%'"

# -- custom variables ----------------------------------------------------------

# to define a custom #{foo} variable, define a POSIX shell function between the
# '# EOF' and the '# "$@"' lines. Please note that the opening brace { character
# must be on the same line as the function name otherwise the parse won't detect
# it.
#
# then, use #{foo} in e.g. the 'tmux_conf_theme_status_left' or the
# 'tmux_conf_theme_status_right' variables.

# ------------------------------------------------------------------------------

# # /!\ do not remove the following line
# EOF
#
# # /!\ do not "uncomment" the functions: the leading "# " characters are needed
#
# # usage: #{sysmon #{TMUX_PLUGIN_MANAGER_PATH}}
# # 每 10s 采样一次 CPU/RAM，结果写进 user option；状态栏只读 #{@cpu} / #{@ram}，
# # 渲染期零 fork。采样仍复用 tmux-cpu 的脚本，不重复实现跨平台逻辑。
# #
# # @cpu_n / @ram_n 是补零到 3 位的整数，供 status_right 里 #{>=:...} 判阈值。
# # 必须补零：tmux 的比较是字符串比较，"7%" >= "30" 会因 '7'>'3' 误判为真；
# # 定宽补零后 strcmp 才等价于数值比较（已在 000-999 范围内验证）。
# #
# # 末尾 sleep 是节流阀：tmux 在 job 退出前不会重新 fork 它，所以 sleep 时长
# # 决定采样周期，与 status-interval 无关。退出后由下次重绘拉起，因此改完这个
# # 函数最多 10s 后自动生效，无需 kill-server。
# sysmon() {
#   echo   # 立刻吐一个空行：job 在产出第一行之前，tmux 会把命令串本身渲染成
#          # <cut ... | sh ... not ready> 占位符。oh-my-tmux 的 _battery_status
#          # 用 "#(echo; ...)" 达到同样目的。
#   scripts="$1/tmux-cpu/scripts"
#   cpu=$("$scripts/cpu_percentage.sh"); ram=$("$scripts/ram_percentage.sh")
#   cpu_n=${cpu%%.*}; cpu_n=${cpu_n%\%}
#   ram_n=${ram%%.*}; ram_n=${ram_n%\%}
#   if [ -r /proc/meminfo ]; then
#     swap=$(awk '/^SwapTotal:/{t=$2} /^SwapFree:/{f=$2} END{ if(t>0) printf "%d%%",(t-f)*100/t; else printf "0%%" }' /proc/meminfo)
#   else
#     swap=$(sysctl -n vm.swapusage 2>/dev/null | awk '{ if ($3+0 > 0) printf "%d%%", ($6+0)*100/($3+0); else printf "0%%" }')
#   fi
#   tmux set -g @cpu "$cpu" \; set -g @cpu_n "$(printf '%03d' "${cpu_n:-0}")" \; set -g @ram "$ram" \; set -g @ram_n "$(printf '%03d' "${ram_n:-0}")" \; set -g @swap "${swap:-n/a}"
#   sleep 10
# }
#
# # usage: #{battinfo #{TMUX_PLUGIN_MANAGER_PATH}}
# # 电池独立成一个 60s 周期的 job。三个 tmux-battery 脚本合计 0.39s，原先是每次
# # 重绘各跑一遍（0.35s/轮），现在摊到 60 秒。
# #
