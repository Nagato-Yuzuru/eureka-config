#:schema https://mise.jdx.dev/schema/mise.json
# [tools] is generated from .chezmoidata/packages.yaml (via: mise entries)
{{ template "mise-tools" . }}
[settings]
experimental = true
python.uv_venv_auto = "source" # use uv
env_cache = true
env_cache_ttl = "6h"
npm.package_manager = "pnpm"

[tasks.refresh-completions]
description = "generate zsh completions scripts"
run = """
#!/bin/bash
set -e

COMP_DIR="${XDG_DATA_HOME}/zsh/site-functions"
mkdir -p "${COMP_DIR}"

echo "Generating completions into $COMP_DIR..."

function load_completion_from_cache() {
    local cmd="$1"
    local cache_file="${COMP_DIR}/_${cmd}"

    # `command -v`, not `mise which`: some of these are system packages (uv on linux)
    if command -v ${cmd} &>/dev/null && ( [[ ! -f "$cache_file" ]] || [[ "$(command -v ${cmd})" -nt "$cache_file" ]] ); then
        echo "Generating completion for $cmd..."
        
        case "$cmd" in
            kubectl) kubectl completion zsh > "$cache_file" ;;
            k9s)     k9s completion zsh > "$cache_file" ;;
            uv)      uv generate-shell-completion zsh > "${cache_file}" ;;
            buf)     buf completion zsh > "$cache_file" ;;
        esac
    fi

}

# 按需加载
cmds=(
    kubectl
    k9s
    uv
    buf
    )

for cmd in "${cmds[@]}"; do
    load_completion_from_cache "$cmd"
done
"""
