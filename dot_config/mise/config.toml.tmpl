#:schema https://mise.jdx.dev/schema/mise.json
# 2026-01-01 23:09:56
[tools]
go = "latest"
uv = "latest"
rust = "stable"
deno = "latest"
{{- if and (eq .chezmoi.os "darwin") ( eq .chezmoi.arch "amd64" ) }}
"npm:pnpm" = "latest"
{{- else }}
pnpm = "latest"
{{- end }}
node = "lts"

golangci-lint = "latest"


usage = "latest"
terraform = "latest"
opentofu = "latest"
kubectl = "latest"
k9s = "latest"
cmake = "latest"

just = "latest"

buf = "latest"
act = "latest"
wrangler = "latest"
hugo-extended = "latest"
prek = "latest"
vacuum = "latest"
actionlint = "latest"
trivy = "latest"
"go:golang.org/x/tools/gopls" = "latest"
lua-language-server = "latest"
"npm:typescript" = "latest"

[settings]
experimental = true
python.uv_venv_auto = "source" # use uv
env_cache = true
env_cache_ttl = "6h"
npm.package_manager = "pnpm"

[tasks.refresh-completions]
description = "generate zsh completions scripts"
run = """
#!/bin/bash
set -e

COMP_DIR="${XDG_DATA_HOME}/zsh/site-functions"
mkdir -p "${COMP_DIR}"

echo "Generating completions into $COMP_DIR..."

function load_completion_from_cache() {
    local cmd="$1"
    local cache_file="${COMP_DIR}/_${cmd}"

    if command -v ${cmd} &>/dev/null && ( [[ ! -f "$cache_file" ]] || [[ "$(mise which ${cmd})" -nt "$cache_file" ]] ); then
        echo "Generating completion for $cmd..."
        
        case "$cmd" in
            kubectl) kubectl completion zsh > "$cache_file" ;;
            k9s)     k9s completion zsh > "$cache_file" ;;
            uv)      uv generate-shell-completion zsh > "${cache_file}" ;;
            buf)     buf completion zsh > "$cache_file" ;;
        esac
    fi

}

# 按需加载
cmds=(
    kubectl
    k9s
    uv
    buf
    )

for cmd in "${cmds[@]}"; do
    load_completion_from_cache "$cmd"
done
"""
