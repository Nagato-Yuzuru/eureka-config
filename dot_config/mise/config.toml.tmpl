#:schema https://mise.jdx.dev/schema/mise.json
# [tools] is compiled by `uv run render` from .chezmoidata/packages.toml (via: mise entries)
[tools]
{{ includeTemplate "artifact" (merge (dict "name" "mise-tools") .) }}
[settings]
experimental = true
python.uv_venv_auto = "source" # use uv
env_cache = true
env_cache_ttl = "6h"
npm.package_manager = "pnpm"
minimum_release_age = "7d"
# mise installs from mise.run (packages.toml), so no `brew upgrade`/`dnf upgrade` carries it.
# It talks to aqua, GitHub releases and language registries that drift, so a stale
# CLI breaks tool resolution, not just mise itself. Interval: auto_update_check_duration.
auto_update = true
# `mise activate` also puts the shims dir on PATH, ahead of ~/.local/bin and the system dirs,
# to install missing or lazy tools on first call. Tools here are batch-installed, so all it
# does is route every command that has a leftover shim through mise (~50ms per call), and
# make `command -v` succeed for tools that are no longer active. Active tools keep their
# real bin dirs on PATH; a command missing entirely still reaches mise's not-found handler.
activate_shims = false

[settings.github]
credential_command = "gh auth token"

# Tasks are files in ~/.config/mise/tasks/, rendered by chezmoi from packages.toml:
#   refresh-completions  regenerate the zsh completions no package manager ships
#   audit-completions    who provides each tool's completion on this machine
[hooks]
# Fires after every `mise install`/`mise use`/`mise up` session, in any directory —
# including project-local installs that touch no completion recipe. --changed keeps
# that cheap: only the completions owned by what this session installed regenerate
# (usually none — the task exits in milliseconds). "[]" = nothing was installed.
# -C: recipes run against the global toolset, not the calling project's pins.
postinstall = '[ "$MISE_INSTALLED_TOOLS" = "[]" ] || mise -C "$HOME" run refresh-completions --changed'
