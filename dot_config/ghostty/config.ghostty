font-family = JetBrainsMono Nerd Font
font-style = Medium
font-size = 14

theme = TokyoNight Storm

cursor-color = #E98038
cursor-text = #FFFFFF

# ── 光标样式 ──（对应 default_cursor_style = "SteadyBlock"）
cursor-style = block
cursor-style-blink = false

background-opacity = 0.95

macos-titlebar-style = hidden

window-padding-x = 5
window-padding-y = 5

window-width = 120
window-height = 30

macos-option-as-alt = left

selection-word-chars = " \t{}[]()\"'`,;:"

shell-integration-features = no-cursor,no-sudo,title,ssh-env,ssh-terminfo,path

auto-update = check
auto-update-channel = stable

mouse-hide-while-typing = true

link-url = true

