font-family = JetBrainsMono Nerd Font
font-style = Medium
font-size = 14

theme = TokyoNight Storm

cursor-color = #E98038
cursor-text = #FFFFFF

# ── 光标样式 ──（对应 default_cursor_style = "SteadyBlock"）
cursor-style = block
cursor-style-blink = false

cursor-click-to-move = true

background-opacity = 0.95

macos-titlebar-style = hidden


# 让底部内边距/余数像素用相邻单元格背景色填充,消除 tmux 状态栏下方的空隙
window-padding-color = extend
window-padding-y = 5,1
window-padding-x = 5,5
window-padding-balance = true
window-step-resize = true

window-width = 120
window-height = 30

macos-option-as-alt = left

selection-word-chars = " \t{}[]()\"'`,;:"

shell-integration-features = no-cursor,no-sudo,title,ssh-env,ssh-terminfo,path

auto-update = check
auto-update-channel = stable

mouse-hide-while-typing = true

mouse-scroll-multiplier = precision:0.7,discrete:1.5

link-url = true

macos-icon = custom
macos-custom-icon = ~/.config/ghostty/ghostty-catppuccin-macchiato.icns

working-directory = home
window-inherit-working-directory = false
tab-inherit-working-directory    = false
split-inherit-working-directory  = true
