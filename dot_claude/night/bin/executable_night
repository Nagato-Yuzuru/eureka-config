#!/usr/bin/env bash
# night — run one command inside the night credential profile.
#
# Hygiene comes from the flag (zshenv sources env.sh in every Claude shell);
# credentials exist only per-invocation, freshly resolved from the lease
# ledger on every call (--no-daemon: no cross-boundary memory cache, expiry
# decided against the ledger each time). A dead or absent lease fails the
# invocation in milliseconds with the remedy in the error text — no cache,
# no renewal; local-only until the owner re-mints awake.
#
# Every command rides `fnox exec`: real credentials, this process tree only.
# (`fnox proxy run` — placeholder in the tree, destination-scoped injection —
# is the wanted gh channel, but 1.34.0's proxy rules cannot reference leases;
# probed decisively, asked upstream alongside the trust model. When it lands,
# gh moves to proxy and the gh checks below become config, not code.)
#
# -c pins the config chain to the global file: the lease ledger key becomes
# cwd-independent (one arm covers /private/tmp scratch too), and no project's
# own fnox.toml can override or inject night credential config.
set -euo pipefail

CFG="$HOME/.config/fnox/config.toml"

die() {
    printf 'night: %s\n' "$*" >&2
    exit 3
}

(($#)) || die "usage: night <command> [args...]"

# The one surviving command inspection, at the credential injection point, on
# real argv: the lease's Contents:write cannot be narrowed below force-push /
# ref-delete / default-branch pushes server-side (branch rulesets need a
# public repo or GitHub Pro — YUZ-74 canceled), so the line is drawn here.
prog="${1##*/}"
if [[ "$prog" == git ]]; then
    args=("${@:2}")
    sub='' i=0
    while ((i < ${#args[@]})); do
        case "${args[i]}" in
            -C | -c | --git-dir | --work-tree | --namespace | --config-env) i=$((i + 2)) ;;
            -*) i=$((i + 1)) ;;
            *)
                sub="${args[i]}"
                break
                ;;
        esac
    done
    if [[ "$sub" == push ]]; then
        for a in "${args[@]}"; do
            case "$a" in
                --force | --force-with-lease* | -f | --delete | -d | --mirror)
                    die "T3: git push $a rewrites or removes published refs. Push plain fast-forwards to claude/*; propose anything stronger in the shift report." ;;
                main | master | refs/heads/main | refs/heads/master | *:main | *:master | *:refs/heads/main | *:refs/heads/master)
                    die "T1: an explicit main/master destination is never on the night task list. Push claude/* branches; queue or propose the rest." ;;
            esac
        done
    fi
fi

if [[ "$prog" == gh ]]; then
    args=("${@:2}")
    subcmd='' verb='' method='' fields=0 i=0
    while ((i < ${#args[@]})); do
        a="${args[i]}"
        case "$a" in
            -X | --method)
                method="${args[i + 1]:-}"
                i=$((i + 2))
                ;;
            -X*)
                method="${a#-X}"
                i=$((i + 1))
                ;;
            --method=*)
                method="${a#--method=}"
                i=$((i + 1))
                ;;
            -f | -F | --field | --raw-field | --input)
                fields=1
                i=$((i + 2))
                ;;
            -f* | -F* | --field=* | --raw-field=* | --input=*)
                fields=1
                i=$((i + 1))
                ;;
            -R | --repo | --hostname) i=$((i + 2)) ;;
            -*) i=$((i + 1)) ;;
            *)
                if [[ -z "$subcmd" ]]; then
                    subcmd="$a"
                elif [[ -z "$verb" ]]; then
                    verb="$a"
                fi
                i=$((i + 1))
                ;;
        esac
    done
    if [[ "$subcmd" == release ]]; then
        case "$verb" in
            create | delete | delete-asset | edit | upload)
                die "T3: gh release $verb mutates GitHub state beyond pushes (releases ride Contents:write — the one hole the App cannot close). Propose it in the shift report." ;;
        esac
    fi
    if [[ "$subcmd" == api ]]; then
        m=$(printf '%s' "$method" | tr '[:lower:]' '[:upper:]')
        case "$m" in
            POST | PUT | PATCH | DELETE)
                die "T3: mutating GitHub API call ($m). T2-shaped speech goes in the queue; T3 is a shift-report proposal." ;;
        esac
        if ((fields)) && [[ "$m" != GET ]]; then
            die "T3: gh api with body fields defaults to POST. For a read, make the method explicit: night gh api -X GET ... -f key=value."
        fi
    fi
fi

# Testability seam: golden tables drive the checks without executing anything.
if [[ "${NIGHT_SHIM_CHECK_ONLY:-}" == 1 ]]; then
    exit 0
fi

exec fnox -c "$CFG" -P night --no-daemon exec -- "$@"
