#!/usr/bin/env bash
# night: run one command inside the night credential profile.
#
# Hygiene comes from the flag (zshenv sources env.sh in every Claude shell).
# Credentials exist only per invocation, freshly resolved from the lease
# ledger on every call (--no-daemon: no cross-boundary memory cache, expiry
# decided against the ledger each time). A dead or absent lease fails the
# invocation in milliseconds with the remedy in the error text. No cache,
# no renewal: local-only until the owner re-mints awake.
#
# Every command rides `fnox exec`: real credentials, this process tree only.
# NOTE(YUZ-77): `fnox proxy run` would keep the real token out of this
# process tree entirely, but its rules cannot reference leases (fnox
# 1.34.0), so gh rides exec and the checks below stand in for proxy rules.
#
# -c pins the config chain to the global file: the lease ledger key becomes
# cwd-independent (one arm covers /private/tmp scratch too), and no project's
# own fnox.toml can override or inject night credential config.
#
# What the checks are, honestly (YUZ-87): DIRECT git and gh invocations are
# really checked — git push by ref-update modeling (below), gh by argv at
# this injection point. Indirection around the shim — `bash -c`, `env`,
# `sh -c`, git aliases — is a known residual this file cannot see; the real
# boundary for that class is the fnox proxy (YUZ-77). Credential isolation
# itself rests on issuance (the App's permissions), not on these checks.
set -euo pipefail

CFG="$HOME/.config/fnox/config.toml"

die() {
    printf 'night: %s\n' "$*" >&2
    exit 3
}

# Executor: every allowed command leaves through here.
# NIGHT_SHIM_EXEC=direct is the test seam — run WITHOUT credential
# injection (a strict downgrade: every check still runs, no lease is
# resolved; used to drive the push judgment against local fixture remotes).
# NIGHT_SHIM_CHECK_ONLY=1 stops before executing anything: golden tables
# exercise the argv checks alone.
exec_night() {
    if [[ "${NIGHT_SHIM_CHECK_ONLY:-}" == 1 ]]; then
        # non-zero on purpose (YUZ-92): a silent exit 0 read as "the
        # command ran" to a calling agent. 10 = checks passed, nothing
        # executed; 3 stays the deny code.
        printf 'night: check-only — checks passed, command NOT executed\n' >&2
        exit 10
    fi
    if [[ "${NIGHT_SHIM_EXEC:-}" == direct ]]; then
        exec "$@"
    fi
    # --no-defaults: the top-level [secrets] table never merges into the
    # night profile, so a base secret is mechanically outside the night
    # surface — the flag replaces the old comment+test defenses (YUZ-92)
    exec fnox -c "$CFG" --no-defaults -P night --no-daemon exec -- "$@"
}

# ---------------------------------------------------------------------------
# git push: ref-update modeling (YUZ-87). No argv spellings — the verdict is
# made on what the push WOULD DO, as the remote reports it. The judge phase
# runs inside the same credentialed exec as the real push (one lease
# resolution covers dry-run, verdict and push):
#
#   `git push --dry-run --porcelain` returns one line per ref update, with
#   the resolved destination ref and a flag: `+` forced update, `-` delete,
#   `*` new, `=` up to date, space fast-forward, `!` rejected.
#     +  → deny  T3: history rewrite (any spelling: --force, -f clusters,
#                    +refspec, --mirror, force-with-lease that would rewrite)
#     -  → deny  T3: ref removal (--delete, -d, :refspec, --prune, --mirror)
#     destination == the remote's default branch (ls-remote --symref HEAD),
#     or refs/heads/{main,master} by resolved name (belt for empty or
#     mislabeled remotes)
#        → deny  T1: default-branch push, whatever the branch is called
#   A dry-run the remote itself refuses (auth, non-fast-forward without
#   force, unknown ref) is relayed verbatim with git's own exit code: the
#   real error from the real boundary.
#
# A --force spelling that would NOT rewrite (fast-forward) is allowed: the
# model judges effects, not vocabulary.
# ---------------------------------------------------------------------------

# judge_push SUBIDX GIT_ARGV... — the credentialed phase. SUBIDX is the
# index of "push" within GIT_ARGV[1:]. Dry-runs, judges, then execs the
# real push. Never returns.
judge_push() {
    local subidx="$1"
    shift
    local -a argv=("$@")
    # git [globals] push --dry-run --porcelain [pushargs]
    local -a dry=("${argv[@]:0:subidx+2}" --dry-run --porcelain "${argv[@]:subidx+2}")
    local out rc=0
    out=$("${dry[@]}") || rc=$?
    if ((rc)); then
        # the remote's own refusal — relay it untouched
        [[ -n "$out" ]] && printf '%s\n' "$out"
        exit "$rc"
    fi
    local line flag pair dest url=''
    local -a dests=()
    while IFS= read -r line; do
        case "$line" in
            "To "*) url="${line#To }" ;;
            *$'\t'*)
                flag="${line%%$'\t'*}"
                pair="${line#*$'\t'}"
                pair="${pair%%$'\t'*}"
                dest="${pair##*:}"
                case "$flag" in
                    +) die "T3: this push would rewrite published history on $url ($pair). Nothing on a night task list rewrites refs; propose it in the shift report." ;;
                    -) die "T3: this push would delete $dest on $url. Ref removal is never night work; propose it in the shift report." ;;
                esac
                dests+=("$dest")
                ;;
        esac
    done <<< "$out"
    if ((${#dests[@]})); then
        # the remote's ACTUAL default branch; empty on an empty remote
        # (nothing exists there to protect — the belt below still holds)
        local default_ref=''
        default_ref=$("${argv[@]:0:subidx+1}" ls-remote --symref "$url" HEAD 2> /dev/null \
            | sed -n $'s/^ref: \\(.*\\)\tHEAD$/\\1/p' | head -n 1) || true
        for dest in "${dests[@]}"; do
            if [[ -n "$default_ref" && "$dest" == "$default_ref" ]]; then
                die "T1: this push targets the remote's default branch ($dest on $url) — never on a night task list. Push claude/* branches; queue or propose the rest."
            fi
            case "$dest" in
                refs/heads/main | refs/heads/master)
                    die "T1: this push targets $dest on $url — a default-branch name is never a night destination even when HEAD points elsewhere." ;;
            esac
        done
    fi
    unset NIGHT_SHIM_PHASE
    exec "${argv[@]}"
}

(($#)) || die "usage: night <command> [args...]"

prog="${1##*/}"
if [[ "$prog" == git ]]; then
    args=("${@:2}")
    sub='' i=0
    while ((i < ${#args[@]})); do
        case "${args[i]}" in
            -C | -c | --git-dir | --work-tree | --namespace | --config-env) i=$((i + 2)) ;;
            -*) i=$((i + 1)) ;;
            *)
                sub="${args[i]}"
                break
                ;;
        esac
    done
    if [[ "$sub" == push ]]; then
        if [[ "${NIGHT_SHIM_PHASE:-}" == judge ]]; then
            judge_push "$i" "$@"
        fi
        # one credentialed exec carries dry-run, verdict and the push itself
        exec_night env NIGHT_SHIM_PHASE=judge bash "${BASH_SOURCE[0]}" "$@"
    fi
fi

if [[ "$prog" == gh ]]; then
    args=("${@:2}")
    subcmd='' verb='' method='' fields=0 i=0
    while ((i < ${#args[@]})); do
        a="${args[i]}"
        case "$a" in
            -X | --method)
                method="${args[i + 1]:-}"
                i=$((i + 2))
                ;;
            -X*)
                method="${a#-X}"
                i=$((i + 1))
                ;;
            --method=*)
                method="${a#--method=}"
                i=$((i + 1))
                ;;
            -f | -F | --field | --raw-field | --input)
                fields=1
                i=$((i + 2))
                ;;
            -f* | -F* | --field=* | --raw-field=* | --input=*)
                fields=1
                i=$((i + 1))
                ;;
            -R | --repo | --hostname) i=$((i + 2)) ;;
            -*) i=$((i + 1)) ;;
            *)
                if [[ -z "$subcmd" ]]; then
                    subcmd="$a"
                elif [[ -z "$verb" ]]; then
                    verb="$a"
                fi
                i=$((i + 1))
                ;;
        esac
    done
    if [[ "$subcmd" == release ]]; then
        case "$verb" in
            create | delete | delete-asset | edit | upload)
                die "T3: gh release $verb mutates GitHub state beyond pushes (releases ride Contents:write — the one hole the App cannot close). Propose it in the shift report." ;;
        esac
    fi
    if [[ "$subcmd" == api ]]; then
        m=$(printf '%s' "$method" | tr '[:lower:]' '[:upper:]')
        case "$m" in
            POST | PUT | PATCH | DELETE)
                die "T3: mutating GitHub API call ($m). T2-shaped speech goes in the queue; T3 is a shift-report proposal." ;;
        esac
        if ((fields)) && [[ "$m" != GET ]]; then
            die "T3: gh api with body fields defaults to POST. For a read, make the method explicit: night gh api -X GET ... -f key=value."
        fi
    fi
fi

exec_night "$@"
