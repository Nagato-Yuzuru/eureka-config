#!/usr/bin/env bash
# git-night — git with the night environment injected per-invocation.
# For sessions that were already running when night mode was flipped on
# (claude-night sessions have this environment from birth and don't need it).
# No local policy: the PAT's repo selection and GitHub rulesets are the
# boundary; claude/* branches are convention, morning review is the check.

set -euo pipefail

CONFIG="$HOME/.claude/night/config.json"
PAT_SVC=$(jq -r '.keychain.gh_pat // "claude-night.gh-pat"' "$CONFIG" 2> /dev/null || echo claude-night.gh-pat)

GH_TOKEN=$(security find-generic-password -s "$PAT_SVC" -w 2> /dev/null || true)
export GH_TOKEN   # empty is fine for local ops; network ops then fail fast

export SSH_AUTH_SOCK=""
export GIT_TERMINAL_PROMPT=0
export GIT_CONFIG_COUNT=5
export GIT_CONFIG_KEY_0=commit.gpgsign GIT_CONFIG_VALUE_0=false
export GIT_CONFIG_KEY_1=url.https://github.com/.insteadOf GIT_CONFIG_VALUE_1=git@github.com:
export GIT_CONFIG_KEY_2=url.https://github.com/.insteadOf GIT_CONFIG_VALUE_2=ssh://git@github.com/
export GIT_CONFIG_KEY_3=credential.helper GIT_CONFIG_VALUE_3=
export GIT_CONFIG_KEY_4=credential.helper GIT_CONFIG_VALUE_4='!gh auth git-credential'

exec git "$@"
