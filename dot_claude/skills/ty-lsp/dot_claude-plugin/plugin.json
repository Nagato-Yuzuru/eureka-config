{
  "name": "ty-lsp",
  "version": "0.1.0",
  "description": "ty as the Python language server, run through uv so a project's pinned ty wins over the global one",
  "lspServers": {
    "ty": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${CLAUDE_PROJECT_DIR}",
        "--no-sync",
        "ty",
        "server"
      ],
      "extensionToLanguage": {".py": "python", ".pyi": "python"}
    }
  }
}
