{
  "$merge": {
    "permissions.ask": "ensure",
    "autoMode.soft_deny": "ensure",
    "hooks.*": "keyed"
  },
  "permissions": {
    "ask": [
      "Bash(*path-gate.sh grant *)",
      "Bash(*path-gate.sh revoke *)"
    ]
  },
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Any shell command that creates, modifies, or deletes files outside the current project directory and its configured additional directories — especially system or application configuration (dotfiles, shell rc files, /etc, ~/Library, LaunchAgents, global git config, ~/.claude settings). Redirection, tee, cp/mv, sed -i, defaults write, git config --global etc. all count."
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Read|Grep|Glob|Edit|Write|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/path-gate.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Read|Grep|Glob|Edit|Write|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/path-gate.sh record",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^(Read|Grep|Glob|Edit|Write|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/path-gate.sh record",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
