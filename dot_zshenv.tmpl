# One copy of each entry, the first: every prepend below and in .zshrc moves an entry to the
# front instead of stacking another copy in each nested shell (tmux, IDE terminals, subshells).
typeset -U path fpath

path=("${HOME}/.local/bin" $path)

# rustup's proxies (cargo, rustc, rust-analyzer) and `cargo install` binaries.
path=("${HOME}/.cargo/bin" $path)

export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/{{ .xdg.dataHome }}"
export XDG_STATE_HOME="$HOME/{{ .xdg.stateHome }}"
export XDG_CACHE_HOME="$HOME/{{ .xdg.cacheHome }}"

# `uv self update` re-runs the installer, which edits shell profiles unless told not to.
# These files are chezmoi's; an edit here is lost on the next apply, silently.
export UV_NO_MODIFY_PATH=1

export PNPM_HOME="${XDG_DATA_HOME}/pnpm"
path=("$PNPM_HOME/bin" $path)
