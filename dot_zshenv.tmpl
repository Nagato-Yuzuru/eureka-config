export PATH="${HOME}/.local/bin:$PATH"

export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/{{ .xdg.dataHome }}"
export XDG_STATE_HOME="$HOME/{{ .xdg.stateHome }}"
export XDG_CACHE_HOME="$HOME/{{ .xdg.cacheHome }}"

export PNPM_HOME="${XDG_DATA_HOME}/pnpm"
case ":$PATH:" in
*":$PNPM_HOME/bin:"*) ;;
*) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac

# Night mode: hygiene env for every Claude-spawned shell while the flag
# exists. CLAUDECODE guards scope: interactive terminals, cron and launchd
# never match, so the owner's own shells keep the day environment.
[[ -n "$CLAUDECODE" && -e "$HOME/.claude/night/active.json" ]] && source "$HOME/.claude/night/env.sh"
