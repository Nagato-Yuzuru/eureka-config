#!/bin/bash
# System packages and uv tools for this machine, rendered from
# .chezmoidata/packages.yaml. chezmoi re-runs this whenever the rendered content
# changes, i.e. whenever this machine's package set changes.
set -euo pipefail

{{ if eq .chezmoi.os "darwin" -}}
if ! command -v brew >/dev/null 2>&1; then
    echo "Homebrew not found. Skipping installation." >&2
    exit 0
fi

brew bundle install --file=- <<'EOF'
{{ template "brewfile" . }}
EOF
{{- end }}

{{- if eq .chezmoi.os "linux" }}
if ! command -v dnf >/dev/null 2>&1; then
    echo "dnf not found (non-Fedora Linux?). Skipping package installation." >&2
    exit 0
fi

# `config-manager` and `copr` are DNF5 plugin subcommands (Fedora 41+)
rpm -q dnf5-plugins >/dev/null 2>&1 || sudo dnf -y install dnf5-plugins

# Both commands are idempotent; re-running keeps disabled/rotated repos current.
while read -r kind arg; do
    case "$kind" in
    copr) sudo dnf -y copr enable "$arg" ;;
    repofile) sudo dnf -y config-manager addrepo --overwrite --from-repofile="$arg" ;;
    esac
done <<'EOF'
{{ template "dnf-repos" . }}
EOF

xargs -r sudo dnf -y install <<'EOF'
{{ template "dnf-list" . }}
EOF
{{- end }}

# Python CLIs, one venv each under `uv tool dir`, entry points in ~/.local/bin.
# uv is a system package installed above. `uv tool install` is idempotent: an
# already-installed tool is left alone (upgrades are `uv tool upgrade`, by hand,
# like the system packages'); a `name@version` line re-pins it when the pin moves.
while read -r spec; do
    [ -n "$spec" ] || continue
    uv tool install "$spec"
done <<'EOF'
{{ template "uv-tools" . }}
EOF
