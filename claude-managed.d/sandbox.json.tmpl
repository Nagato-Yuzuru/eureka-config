{
  "$merge": {
    "sandbox.network.allowUnixSockets": "ensure",
    "sandbox.filesystem.allowWrite": "ensure",
    "sandbox.filesystem.denyWrite": "ensure"
  },
  "env": {
    "NODE_OPTIONS": "--use-env-proxy"
  },
  "sandbox": {
{{- if eq .chezmoi.os "darwin" }}
    "network": {
      "allowUnixSockets": [
        "{{ .chezmoi.homeDir }}/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ]
    },
{{- end }}
    "filesystem": {
      "allowWrite": [
        "{{ .chezmoi.homeDir }}/{{ .xdg.cacheHome }}/uv",
        "{{ .chezmoi.homeDir }}/{{ .xdg.cacheHome }}/pnpm",
        "{{ .chezmoi.homeDir }}/{{ .xdg.dataHome }}/pnpm",
        "{{ .chezmoi.homeDir }}/go/pkg",
        "{{ .chezmoi.homeDir }}/.cargo/registry",
        "{{ .chezmoi.homeDir }}/.cargo/git",
        "{{ .chezmoi.homeDir }}/.npm/_cacache",
{{- if eq .chezmoi.os "darwin" }}
        "{{ .chezmoi.homeDir }}/Library/Caches/go-build"
{{- else }}
        "{{ .chezmoi.homeDir }}/{{ .xdg.cacheHome }}/go-build"
{{- end }}
      ],
      "denyWrite": [
        "{{ .chezmoi.homeDir }}/{{ .xdg.dataHome }}/pnpm/bin",
        "{{ .chezmoi.homeDir }}/{{ .xdg.dataHome }}/pnpm/global"
      ]
    },
    "enabled": false,
    "enableWeakerNetworkIsolation": true,
    "allowUnsandboxedCommands": true
  }
}
