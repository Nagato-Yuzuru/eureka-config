{
  "$merge": {
    "permissions.ask": "ensure",
    "hooks.*": "keyed"
  },
  "env": {
    "CLAUDE_CODE_DISABLE_EXPLORE_PLAN_AGENTS": "1"
  },
  "permissions": {
    "ask": [
{{- range $i, $m := .claude.routing.gated }}{{ if $i }},{{ end }}
      "Agent(model:*{{ $m }}*)"
{{- end }}
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/require-agent-model.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^Workflow$",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/require-workflow-routing.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
