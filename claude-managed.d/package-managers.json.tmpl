{
  "$merge": {
    "hooks.*": "keyed"
  },
  "$legacyHooks": [
    "claude-block-npm"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/block-package-managers.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(Write|Edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.claude/hooks/protect-lockfiles.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
