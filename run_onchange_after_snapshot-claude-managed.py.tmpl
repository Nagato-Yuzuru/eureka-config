#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# ///
# Advances the settings merge's base snapshot once an apply has converged; the
# engine is tools/claude_managed.py. chezmoi re-runs a run_onchange_ script when its
# rendered text changes, and this text embeds the rendered fragments, so it re-runs
# exactly when a fragment renders differently — an edit, an added or deleted
# fragment, or a .chezmoidata change a fragment template reads.
import sys

sys.dont_write_bytecode = True  # no __pycache__ inside the chezmoi source tree
sys.path.insert(0, {{ joinPath .chezmoi.sourceDir "tools" | toJson }})
import claude_managed

FRAGMENTS = {{ includeTemplate "claude-managed-fragments" . | toJson }}
sys.exit(claude_managed.snapshot(FRAGMENTS))
