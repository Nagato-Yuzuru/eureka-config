export LANG=en_US.UTF-8

if [[ -x /opt/homebrew/bin/brew ]];then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

local gnu_path=""
for gnu in make grep gnu-sed gawk coreutils; do
    gnu_path="/opt/homebrew/opt/${gnu}/libexec/gnubin:$gnu_path"
done

export PATH="$gnu_path$PATH"

export PATH="$PATH:${HOME}/Library/Application Support/JetBrains/Toolbox/scripts"

export EDITOR=nvim 
# ------------
source "$(brew --prefix)/share/antidote/antidote.zsh"
antidote load

fpath=(
    "${HOME}"/.docker/completions
    "${HOME}/.zsh/completions"
    '/opt/homebrew/share/zsh/site-functions'
    "${fpath[@]}"
)

fpath=(${(u)fpath}) 

autoload -Uz compinit
compinit

autoload bashcompinit && bashcompinit 

complete -C "$(which aws_completer)" aws 
complete -o nospace -C "$(which terraform)" terraform

zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}' 
zstyle ':completion:*' menu select


# MISE

eval "$(mise activate zsh)"


# Starship
eval "$(starship init zsh)"

# Zoxide 
eval "$(zoxide init zsh)"


# 1password
[ -f "$HOME/.config/op/plugins.sh" ] && source "${HOME}/.config/op/plugins.sh"

# fzf
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh


# -------------------
# zsh options

bindkey -e

setopt auto_cd
setopt autopushd
typeset -i DIRSTACKSIZE=127

export WORDCHARS=${WORDCHARS/\/}
export HOMEBREW_AUTO_UPDATE_SECS=3600

# shell hotkey settings

autoload -Uz edit-command-line 
zle -N edit-command-line 
bindkey '^U' backward-kill-line 
bindkey '^X^E' edit-command-line

autoload -Uz reverse-menu-complete 
zle -N reverse-menu-complete 
zmodload zsh/complist 
bindkey -M menuselect '^[[Z' reverse-menu-complete




# aliases
alias rm='rm -i' 
alias mv='mv -i'
alias typora='open -a Typora' 
alias vim='nvim' 
alias watch='watch --color' 
alias ls='ls -G --color=auto' 
alias grep='grep --color=auto'

alias pip='uv pip' 
alias pip3='uv pip'
alias python='python3' 

alias fd='fd --color=auto'
alias cleanproxy='networksetup -setwebproxystate Wi-Fi off && networksetup -setsecurewebproxystate Wi-Fi off && networksetup -setautoproxystate Wi-Fi off'
alias tf='terraform'


function wellcome() {
    if ! command -v cowsay &> /dev/null; then return; fi
    
    local cows=( alpaca bud-frogs cheese cupcake daemon elephant eyes fox head-in llama milk moose mutilated stegosaurus sus turtle tux)
    local cow=$(shuf -n 1 -e "${cows[@]}")
    local mood=$(shuf -n 1 -e -- -b -d -g -p -s -t -w) 
    
    figlet -c "Welcome $1" \
        | cowsay -n "$mood" -f "$cow" \
        | lolcat
}



[[ -o interactive ]] && wellcome "YuzuRu"

